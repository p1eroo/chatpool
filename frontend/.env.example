# URL base del backend Chatpool
VITE_API_URL=http://localhost:3001

# true = datos mock + localStorage; false = llamadas HTTP al backend
VITE_USE_MOCK=false

# Placeholder en Documentación (sustituir por el id real de cada bandeja)
VITE_API_INBOX_ID=INBOX_ID

# Base pública para webhooks (Meta, etc.). Por defecto: {VITE_API_URL}/webhooks
VITE_WEBHOOK_BASE_URL=https://api.chatpool.app/webhooks