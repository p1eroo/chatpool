# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL (ajusta host si tu servidor es remoto)
DATABASE_URL="postgresql://chatpool:CAMBIAR_PASSWORD@localhost:5432/chatpool?schema=public"

# JWT
JWT_SECRET=genera-un-secreto-largo-y-aleatorio-aqui
# JWT (duración del token; la sesión se cierra con logout o login en otro dispositivo)
JWT_EXPIRES_IN=365d

# CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5174

# URLs públicas para webhooks (Meta debe poder alcanzar esta URL)
# En local usa ngrok/cloudflared: https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:3001
WEBHOOK_BASE_URL=http://localhost:3001/webhooks

# Meta Graph API
META_GRAPH_VERSION=v21.0
META_APP_SECRET=

# MinIO / S3 (bucket público chatpool-media)
S3_ENDPOINT=https://cdn.3w.pe
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=chatpool-media
S3_PUBLIC_URL=https://cdn.3w.pe
S3_FORCE_PATH_STYLE=true
FILES_MAX_MB=50
